 <!-- Unified v0.8.35 Neon Ghost: restrained, inset rails, consistent hover for all scrollable views. -->
 <Style x:Key="NeonGuideScrollBar" TargetType="ScrollBar">
  <Setter Property="Width" Value="15"/>
  <Setter Property="MinWidth" Value="15"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ScrollBar">
    <Border x:Name="ScrollLane" Background="#141B35" BorderBrush="#36476B" BorderThickness="0.6" CornerRadius="6" Margin="2,8,5,8" SnapsToDevicePixels="True">
     <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Cursor="Hand">
       <Thumb.Template><ControlTemplate TargetType="Thumb">
        <Border x:Name="ScrollThumb" Background="#8154C8" BorderBrush="#8B9DE6" BorderThickness="0.8" CornerRadius="5" SnapsToDevicePixels="True"/>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ScrollThumb" Property="Background" Value="#A869E9"/>
          <Setter TargetName="ScrollThumb" Property="BorderBrush" Value="#5CEBFF"/>
          <Setter TargetName="ScrollThumb" Property="Effect"><Setter.Value><DropShadowEffect Color="#51DFFF" BlurRadius="7" ShadowDepth="0" Opacity="0.55"/></Setter.Value></Setter>
         </Trigger>
         <Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#BF83F4"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Thumb.Template>
      </Thumb></Track.Thumb>
