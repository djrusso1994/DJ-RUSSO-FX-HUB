  <Image x:Name="ProductPanelLogo" Source="Assets/meter-x.png" Height="132" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,0,0,9" RenderOptions.BitmapScalingMode="Fant"/>
  <TextBlock x:Name="ProductPanelDescription" Text="Spectrum · Waveform · Spectrogram · Loudness · Peak/RMS · Vectorscope · Frequency Bands · Correlation" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoBrush}" Margin="0,5,0,13"/>
  <Button x:Name="MeterPanelInstallButton" Content="INSTALL / INSTALLA" Style="{StaticResource NeonActionButton}" Click="SelectedProductInstall_Click" Margin="0,0,0,8" BorderBrush="#24E977" Background="#0D3729"/>
  <Button x:Name="MeterPanelRemoveButton" Content="REMOVE / RIMUOVI" Style="{StaticResource NeonActionButton}" Click="SelectedProductRemove_Click" Margin="0,0,0,8" BorderBrush="#E13AF5" Background="#392044"/>
  <Button x:Name="MeterPanelLaunchButton" Content="▶  LAUNCH / AVVIA" Style="{StaticResource NeonActionButton}" Click="SelectedProductLaunch_Click" Margin="0,0,0,12" BorderBrush="#3FEFFF" Background="#0C3846"/>
  <Button x:Name="PluginUpdatesButton" Content="CHECK PLUGIN UPDATES / CONTROLLA AGGIORNAMENTI PLUGIN" Style="{StaticResource NeonActionButton}" Click="CheckPluginUpdates_Click" Margin="0,0,0,10" BorderBrush="#3FEFFF" Background="#112A40" FontSize="10" />
  <TextBlock x:Name="MeterPanelState" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
   <Border Margin="0,12,0,0" Padding="9" CornerRadius="8" Background="#11132B" BorderBrush="#A36AFF" BorderThickness="1">
   <Border.Effect><DropShadowEffect Color="#8B45FF" BlurRadius="17" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
   <StackPanel>
    <TextBlock Text="✦ NEON CHIP PLAYER ✦" Foreground="#7DEFFF" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/>
    <TextBlock x:Name="ChipTrackLabel" Text="GHOST CHIP 01" Foreground="#D58BFF" HorizontalAlignment="Center" FontSize="10" Margin="0,3,0,5"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button x:Name="ChipPlayButton" Width="47" Height="36" Padding="0" Margin="0,0,5,0" Click="ChipPlay_Click" ToolTip="Play / Pause"><Grid Width="26" Height="26"><Path x:Name="ChipPauseIcon" Fill="#7DEFFF" Stretch="Uniform" Data="M 4,2 L 10,2 10,22 4,22 Z M 14,2 L 20,2 20,22 14,22 Z"/><Path x:Name="ChipResumeIcon" Fill="#7DEFFF" Stretch="Uniform" Data="M 4,2 L 22,12 4,22 Z" Visibility="Collapsed"/></Grid></Button>
     <Button Width="47" Height="36" Padding="0" Margin="0,0,5,0" Click="ChipNext_Click" ToolTip="Next track"><Path Width="26" Height="26" Fill="#7DEFFF" Stretch="Uniform" Data="M 1,3 L 11,12 1,21 Z M 11,3 L 21,12 11,21 Z M 22,3 L 25,3 25,21 22,21 Z"/></Button>
     <Button x:Name="ChipMuteButton" Width="47" Height="36" Padding="0" Margin="0" Click="ChipMute_Click" ToolTip="Mute"><Grid Width="26" Height="26"><Path Fill="#7DEFFF" Stretch="Uniform" Data="M 2,8 L 8,8 15,2 15,22 8,16 2,16 Z"/><Path x:Name="ChipSoundWaves" Stroke="#7DEFFF" StrokeThickness="2" StrokeStartLineCap="Round" Fill="Transparent" Stretch="Uniform" Data="M 17,7 C 20,9 20,15 17,17 M 20,3 C 25,8 25,16 20,21"/><Path x:Name="ChipMutedMark" Stroke="#FF87D9" StrokeThickness="3" Stretch="Uniform" Data="M 17,5 L 24,19 M 24,5 L 17,19" Visibility="Collapsed"/></Grid></Button>
     <Slider x:Name="ChipVolumeSlider" Minimum="0" Maximum="100" Value="10" Width="65" Margin="9,0,0,0" VerticalAlignment="Center" ValueChanged="ChipVolume_Changed" ToolTip="Music volume"/>
    </StackPanel>
   </StackPanel>
  </Border>

 </StackPanel></ScrollViewer>
</Border>
