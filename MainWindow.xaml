<Window x:Class="DJRussoFXHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DJ RUSSO FX HUB" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" Width="1500" Height="900" MinWidth="1050" MinHeight="680" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" Icon="Assets/hub.ico" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <SolidColorBrush x:Key="BgBrush" Color="#090C19"/>
 <SolidColorBrush x:Key="PanelBrush" Color="#151A30"/>
 <SolidColorBrush x:Key="FgBrush" Color="#F2F5FF"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#A36AFF"/>
 <SolidColorBrush x:Key="SecondaryBrush" Color="#7DEFFF"/>
 <SolidColorBrush x:Key="LogoPlateBrush" Color="#0D142C"/>
 <SolidColorBrush x:Key="InfoBrush" Color="#C7D4F0"/>
 <LinearGradientBrush x:Key="HeadingBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#71F4FF" Offset="0"/><GradientStop Color="#D58BFF" Offset="1"/></LinearGradientBrush>
 
 <SolidColorBrush x:Key="NeonCyanBrush" Color="#00EFFF"/>
 <SolidColorBrush x:Key="NeonPinkBrush" Color="#F33AFF"/>
 <SolidColorBrush x:Key="NeonGreenBrush" Color="#24EF85"/>
 <SolidColorBrush x:Key="CardStrokeBrush" Color="#7864DD"/>
 <SolidColorBrush x:Key="SidebarBrush" Color="#101127"/>
 <SolidColorBrush x:Key="NavSelectedBrush" Color="#213352"/>
 <LinearGradientBrush x:Key="CardFillBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#14152D" Offset="0"/><GradientStop Color="#111329" Offset="0.6"/><GradientStop Color="#1A0C2D" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="HeaderFillBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#080B1E" Offset="0"/><GradientStop Color="#16112B" Offset="0.55"/><GradientStop Color="#080B1E" Offset="1"/></LinearGradientBrush>
 <Style x:Key="NavNeonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Height" Value="49"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F5F6FF"/>
  <Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/></DataTemplate></Setter.Value></Setter>
  <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="NavFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="SemiBold"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="NavFrame" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
     <Setter TargetName="NavFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#16DFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavFrame" Property="Opacity" Value="0.85"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Dedicated selected-state styling: settings stays visibly active while its panel is shown.
      No ControlTemplate replacement: reuses the tested WPF navigation template. -->
 <Style x:Key="SettingsNavButton" TargetType="Button" BasedOn="{StaticResource NavNeonButton}">
  <Style.Triggers>
   <Trigger Property="Tag" Value="Selected">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#12DBF4" BlurRadius="14" ShadowDepth="0" Opacity="0.58"/></Setter.Value></Setter>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="SocialNeonButton" TargetType="Button">
  <Setter Property="Height" Value="64"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7,5"/>
  <Setter Property="Background" Value="#12172D"/><Setter Property="BorderBrush" Value="#7656E6"/><Setter Property="BorderThickness" Value="1.3"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#56F2FF"/>
     <Setter TargetName="Frame" Property="Effect"><Setter.Value><DropShadowEffect Color="#6C5CFF" BlurRadius="9" ShadowDepth="0" Opacity="0.55"/></Setter.Value></Setter>
    </Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#25224C"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ProductCardStyle" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="1.6"/>
  <Setter Property="CornerRadius" Value="13"/>
  <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#8B42F8" BlurRadius="8" ShadowDepth="0" Opacity="0.24"/></Setter.Value></Setter>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource NeonPinkBrush}"/><Setter Property="BorderThickness" Value="2.8"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#E62AFF" BlurRadius="21" ShadowDepth="0" Opacity="0.85"/></Setter.Value></Setter></DataTrigger>
   <Trigger Property="IsMouseOver" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00DDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/></Setter.Value></Setter>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style>
 <!-- Dropdown controls: high contrast in all three themes. No custom ControlTemplate,
      preserving WPF's tested built-in ComboBox to avoid startup deserialization faults. -->
 <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ComboTextBrush" Color="#15213A"/>
 <SolidColorBrush x:Key="ComboBorderBrush" Color="#7854CE"/>
 <SolidColorBrush x:Key="ComboFocusBrush" Color="#4275CE"/>
 <SolidColorBrush x:Key="ComboHoverBrush" Color="#C9DDFB"/>
 <SolidColorBrush x:Key="ComboSelectedBrush" Color="#DCE5FB"/>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource ComboSurfaceBrush}"/>
  <Setter Property="Padding" Value="9,5"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers>
   <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ComboHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ComboSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource ComboSurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ComboBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1.5"/>
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="MinHeight" Value="35"/>
  <Setter Property="Padding" Value="7,3"/>
  <Setter Property="MaxDropDownHeight" Value="210"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ComboFocusBrush}"/></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ComboFocusBrush}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="#F7F8FF"/>
  <Setter Property="Background" Value="#18243C"/>
  <Setter Property="CaretBrush" Value="#58F5EE"/>
  <Setter Property="BorderBrush" Value="#9A6CFF"/>
  <Setter Property="BorderThickness" Value="1.5"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="MinHeight" Value="39"/>
 </Style>
 <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/></Style>

 <Style x:Key="NeonActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="FontWeight" Value="Bold"/><Setter Property="MinHeight" Value="44"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#9B4CFF" BlurRadius="11" ShadowDepth="0" Opacity="0.52"/></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="NeonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NeonFrame" Property="BorderThickness" Value="3"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NeonFrame" Property="Opacity" Value="0.35"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 </Window.Resources>
