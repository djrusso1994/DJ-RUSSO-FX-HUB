     <TextBlock x:Name="ShellSectionTitle" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}"/>
     <TextBlock x:Name="ShellSectionHint" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     <TextBlock x:Name="ShellSectionStatus" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="ShellInstallButton" Click="InstallShell_Click" Style="{StaticResource NeonActionButton}" Background="#0D3729" BorderBrush="#24E977" MinWidth="145" Margin="8,0,12,0"/>
    <Button Grid.Column="2" x:Name="ShellRemoveButton" Click="RemoveShell_Click" Style="{StaticResource NeonActionButton}" Background="#392044" BorderBrush="#E13AF5" MinWidth="145" Margin="0"/>
   </Grid>
  </Border>
 </Grid>
</Grid>
