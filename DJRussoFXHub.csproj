<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>DJRussoFXHub</AssemblyName><Version>0.8.40</Version><PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit><ApplicationIcon>Assets\hub.ico</ApplicationIcon></PropertyGroup><ItemGroup><Content Include="effect-packages.json" CopyToOutputDirectory="PreserveNewest" /><Content Include="plugins.json" CopyToOutputDirectory="PreserveNewest" /><Content Include="Payload\DJ RUSSO METER X.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" /><Content Include="Payload\DJ RUSSO REVERB X.vst3" Condition="Exists('Payload\DJ RUSSO REVERB X.vst3')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" /><Content Include="Payload\DJ RUSSO FX SHELL.vst3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" /><Content Include="ChipMusic\*.json" CopyToOutputDirectory="PreserveNewest" /><Content Include="ChipMusic\*.wav" CopyToOutputDirectory="PreserveNewest" /><None Include="ChipMusic\MIDI\*.mid" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>  <ItemGroup><Resource Include="Assets\*.png" /><Resource Include="Assets\hub.ico" /></ItemGroup>

  <!-- Sign automatically after a successful Windows Release build. Private key remains in the local certificate store. -->
  <Target Name="DJRussoAutoSignRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(DJRussoEnableSigning)' == 'true'">
    <Message Importance="high" Text="DJ RUSSO: firma digitale gratuita automatica degli EXE Release..." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\FIRMA_DIGITALE_GRATUITA\01_CREA_CERTIFICATO_E_FIRMA_RELEASE.ps1&quot; -OutputDirectory &quot;$(TargetDir)&quot;" />
  </Target>
</Project>